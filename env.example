# Telegram Obsidian Git Bot Configuration
# Скопируйте этот файл в .env и заполните своими значениями

# Токен Telegram бота (получите у @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ID пользователей Telegram (через запятую для нескольких)
# Получите ID у @userinfobot
USER_ID=your_telegram_user_id_here

# GitHub Personal Access Token
# Создайте в GitHub: Settings -> Developer settings -> Personal access tokens
# Требуются права: repo
GIT_TOKEN=your_github_personal_access_token_here

# Имя файла в Obsidian vault
# Файл будет создан в директории obsidian_files/
FILE_NAME=daily.md 